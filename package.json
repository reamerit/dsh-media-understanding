{
  "name": "dsh-media-understanding",
  "version": "0.1.0",
  "description": "DSH 宿主侧插件：本地/链接音视频 → 带时间戳转录 + 带时间戳关键帧真图；GPU 优先、无卡自动降级。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/workers",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "setup": "node scripts/setup-dsh-deps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:readme": "node scripts/check-readme-parity.mjs",
    "test": "node --test test/",
    "verify": "npm run typecheck && npm run check:encoding && npm run check:readme && npm test",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-jobs": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reamerit/dsh-media-understanding.git"
  },
  "homepage": "https://github.com/reamerit/dsh-media-understanding#readme",
  "bugs": {
    "url": "https://github.com/reamerit/dsh-media-understanding/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "media",
    "audio",
    "video",
    "transcribe",
    "whisper",
    "ffmpeg",
    "keyframes"
  ]
}
